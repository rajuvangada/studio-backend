# Server
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:8080

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gkdigital?retryWrites=true&w=majority

# Auth
JWT_SECRET=replace-with-a-64-char-random-string
JWT_EXPIRES_IN=7d
COOKIE_NAME=gk_token
COOKIE_DOMAIN=

# AWS S3
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=gk-digital-studios-media
S3_SIGNED_URL_TTL=900

# First admin bootstrap (npm run seed:admin)
ADMIN_EMAIL=studio@gkdigitalstudios.com
ADMIN_PASSWORD=
ADMIN_NAME=Govind Kumar Gella
